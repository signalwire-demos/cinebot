# CineBot Configuration
# =============================================================================

# TMDB API Key (required for movie/TV data)
TMDB_API_KEY=your-tmdb-api-key

# SignalWire Credentials (required for WebRTC calling)
SIGNALWIRE_SPACE_NAME=your-space
SIGNALWIRE_PROJECT_ID=your-project-id
SIGNALWIRE_TOKEN=your-api-token

# Public URL for SWML callbacks (required for WebRTC calling)
# This should be your publicly accessible URL (e.g., ngrok, dokku domain)
SWML_PROXY_URL_BASE=https://your-app.example.com

# Basic Auth for SWML endpoints (recommended - without them the SDK generates
# random per-process credentials the platform can't use)
# SWML_BASIC_AUTH_USER=signalwire
# SWML_BASIC_AUTH_PASSWORD=your-secure-password

# Agent Configuration
# Fabric resource name; dialable address becomes /public/{AGENT_NAME}.
# Use a distinct name (e.g. cinebot-dev) for local runs - startup repoints
# the URL of whatever handler has this name.
AGENT_NAME=cinebot

# Server Configuration
PORT=3030

# Optional: Post-prompt webhook URL for conversation summaries
# POST_PROMPT_URL=https://your-webhook-url.com/cinebot/summary

# Optional: Redis for TMDB caching
# REDIS_URL=redis://host:6379
